[
{
    "model": "adventure.story",
    "pk": 3,
    "fields": {
        "story_text": "Ξυπνάς μέσα σε ένα δωμάτιο. Δεν γνωρίζεις πώς βρέθηκες εκεί. Κοιτάς γύρω σου και παρατηρείς ότι δεν υπάρχουν παράθυρα. Μόνο μία πόρτα και μία καταπακτή. Ξαφνικά ακούς ένα ανατριχιαστικό γρατζούνισμα στην πόρτα. \r\nΤι κάνεις;",
        "is_start": true,
        "title": "Το άγνωστο δωμάτιο"
    }
},
{
    "model": "adventure.story",
    "pk": 4,
    "fields": {
        "story_text": "Αποφασίζεις να τολμήσεις να δεις τι κρύβεται πίσω από την πόρτα. Την ανοίγεις αλλά δεν είναι κανείς εκεί. Ένα σκοτεινό δωμάτιο απλώνεται μπροστά σου. Στο βάθος του φαίνεται μια έξοδος. Στα αριστερά σου υπάρχει μια ξύλινη σκάλα. Τι κάνεις;",
        "is_start": false,
        "title": "Επιλογή πόρτα"
    }
},
{
    "model": "adventure.story",
    "pk": 5,
    "fields": {
        "story_text": "Μπαίνεις στην καταπακτή. Μια υπόγεια σκάλα φαίνεται να οδηγεί βαθιά μέσα στη γη. Τι κάνεις;",
        "is_start": false,
        "title": "Επιλογή καταπακτή"
    }
},
{
    "model": "adventure.story",
    "pk": 6,
    "fields": {
        "story_text": "Μια τεράστια αυλή απλώνεται μπροστά σου. Παρατηρείς ότι απέναντί σου υπάρχει ένας λαβύρινθος. Πηγαίνεις μέχρι την είσοδό του και παρατηρείς τους διαδρόμους του που φαίνονται. Καταλαβαίνεις ότι μπορεί να χαθείς μέσα, αλλά θα πρέπει να υπάρχει κάποια έξοδος. Εκείνη την ώρα σταματάει ένα αυτοκίνητο στον χώρο μπροστά στο λαβύρινθο. Ο οδηγός σού λέει ότι μπορεί να σε πάρει από αυτό το άγνωστο μέρος, αλλά δεν μπορείς να διαλέξεις τον προορισμό σου. Τι κάνεις;",
        "is_start": false,
        "title": "Επιλογή έξοδος"
    }
},
{
    "model": "adventure.story",
    "pk": 7,
    "fields": {
        "story_text": "Ανεβαίνεις τη σκάλα. Στον επάνω όροφο συναντάς ένα τζίνι. Σου δίνει δύο επιλογές. Σου λέει ότι μπορείς να επιλέξεις να σε κάνει εκείνη τη στιγμή άρχοντα ενός τόπου, και να σου δώσει φοβερή ισχύ, αλλά υπάρχει ένα τίμημα για να διατηρήσεις αυτήν την ισχύ. Εναλλακτικά σου δείχνει μια γέφυρα που ξεκινάει από το κτήριο στο οποίο βρίσκεστε και το τέρμα της χάνεται κάπου μέσα στα σύννεφα. Τι κάνεις;",
        "is_start": false,
        "title": "Επιλογή σκάλα"
    }
},
{
    "model": "adventure.story",
    "pk": 8,
    "fields": {
        "story_text": "Κατεβαίνεις τη σκάλα. Στο τέρμα της υπάρχει ένα τεράστιο άνοιγμα μέσα στη γη. Προχωράς και στην μια πλευρά του ανοίγματος ανακαλύπτεις έναν φωτεινό θάλαμο. Μέσα στο θάλαμο υπάρχει ένας θησαυρός. Στην άλλη πλευρά υπάρχει μια μικρή λίμνη και στην όχθη της είναι δεμένη μια βάρκα.\r\nΤι κάνεις;",
        "is_start": false,
        "title": "Επιλογή υπόγεια σκάλα"
    }
},
{
    "model": "adventure.story",
    "pk": 9,
    "fields": {
        "story_text": "Μόλις μπαίνεις στο δωμάτιο βλέπεις ότι ένα τέρας έχει αρχίσει να σπάει την πόρτα για να μπει μέσα. Αρχίζεις να ψάχνεις γύρω σου και ανακαλύπτεις ένα πορτάκι που δεν είχες παρατηρήσει πριν και ένα τσεκούρι. Τι κάνεις;",
        "is_start": false,
        "title": "Επιλογή επιστροφή στο δωμάτιο"
    }
},
{
    "model": "adventure.story",
    "pk": 10,
    "fields": {
        "story_text": "Μπαίνεις στο λαβύρινθο. Ακολουθείς τις διακλαδώσεις του, συναντάς αδιέξοδο αρκετές φορές, αλλά μετά από ώρα καταφέρνεις να βρεις την έξοδο. Ανακαλύπτεις ότι είναι μια μυστική είσοδος για το υπνοδωμάτιό σου. Είσαι ελεύθερος!",
        "is_start": false,
        "title": "Επιλογή λαβύρινθος"
    }
},
{
    "model": "adventure.story",
    "pk": 11,
    "fields": {
        "story_text": "Μπαίνεις στο αυτοκίνητο ανοίγει μια πύλη προς μια άγνωστη διάσταση, το αυτοκίνητο μπαίνει μέσα και η πύλη κλείνει πίσω σου. Είσαι παγιδευμένος εκεί μέσα για πάντα. Έχασες!",
        "is_start": false,
        "title": "Επιλογή οδηγός"
    }
},
{
    "model": "adventure.story",
    "pk": 12,
    "fields": {
        "story_text": "Είσαι πανευτυχής που ένα τυχαίο γεγονός σε οδήγησε στα πλούτη. Καθώς περιεργάζεσαι θαμπωμένος τα λαμπερά πετράδια, ο δράκος που φύλαγε τον θησαυρό ξεπροβάλει μέσα από τα βουνά των χρυσών φλουριών και σε καταβροχθίζει. Έχασες!",
        "is_start": false,
        "title": "Επιλογή φωτεινός θάλαμος"
    }
},
{
    "model": "adventure.story",
    "pk": 13,
    "fields": {
        "story_text": "Μπαίνεις στη βάρκα και αρχίζεις να τραβάς κουπί. Παρατηρείς ότι βρίσκεσαι μέσα σε μια μεγάλη σπηλιά. Ξαφνικά κάπου στο βάθος αρχίζει να φαίνεται ένα φως. Υπάρχει ένα άνοιγμα στα βράχια. Περνάς από το άνοιγμα και ανακαλύπτεις ότι οδηγεί σε ένα νέο φωτεινό θάλαμο. Εκεί υπάρχει μια πόρτα. Την ανοίγεις και ανακαλύπτεις ότι είναι μια μυστική είσοδος για το υπνοδωμάτιό σου. Είσαι ελεύθερος!",
        "is_start": false,
        "title": "Επιλογή βάρκα"
    }
},
{
    "model": "adventure.story",
    "pk": 14,
    "fields": {
        "story_text": "Το τζίνι σου λέει ότι μόλις έγινες άρχοντας του τόπου στον οποίο βρίσκεσαι. Για να διατηρήσεις την ισχύ σου πρέπει να μείνεις για πάντα παγιδευμένος μέσα στο κτήριο στο οποίο βρίσκεσαι. Έχασες!",
        "is_start": false,
        "title": "Επιλογή άρχοντας"
    }
},
{
    "model": "adventure.story",
    "pk": 15,
    "fields": {
        "story_text": "Με δισταγμό ανεβαίνεις στη γέφυρα. Χάνεσαι μέσα στα σύννεφα και για λίγη ώρα δεν βλέπεις. Συνεχίζεις να προχωράς μέχρι που κάποια στιγμή αρχίζεις να διακρίνεις μια πόρτα. Την ανοίγεις και ανακαλύπτεις ότι είναι μια μυστική πόρτα για το υπνοδωμάτιό σου. Είσαι ελεύθερος!",
        "is_start": false,
        "title": "Επιλογή γέφυρα"
    }
},
{
    "model": "adventure.story",
    "pk": 16,
    "fields": {
        "story_text": "Πριν προλάβεις να κάνεις οποιαδήποτε κίνηση, το τέρας σε κάνει μια χαψιά. Έχασες!",
        "is_start": false,
        "title": "Επιλογή τσεκούρι"
    }
},
{
    "model": "adventure.story",
    "pk": 17,
    "fields": {
        "story_text": "Το πορτάκι αυτό είναι μια μυστική δίοδος προς το υπνοδωμάτιό σου. Είσαι ελεύθερος!",
        "is_start": false,
        "title": "Επιλογή πορτάκι"
    }
},
